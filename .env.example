# Copy to .env (never commit .env). Generate secrets with e.g.:
#   openssl rand -base64 32          (Linux/macOS/Git Bash)
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))   (PowerShell, fine for local dev)

# --- Local docker-compose only ---
POSTGRES_PASSWORD=change-me-local-only

# --- API (docker-compose and Render) ---
# Owner bootstrap secret: required to initialize or recover the instance.
# Minimum 24 characters. Keep it in a password manager; it is never sent after setup.
DAYMARK_SETUP_SECRET=

# production | development (development permits http origins and Lax cookies)
DAYMARK_ENV=development

# Exact origins allowed by CORS, comma separated. No wildcards. https required in production.
ALLOWED_ORIGINS=http://localhost:8081

# --- Render / production only ---
# DATABASE_URL=            # Render injects this from the database (use the INTERNAL URL)
# TRUST_PROXY_HOPS=1       # Render puts one proxy in front; makes rate limits see real client IPs
# COOKIE_SAMESITE=none     # default in production (web app and API on different sites)

# --- Optional tuning (defaults shown) ---
# DEVICE_TTL=4320h             # a device/session expires after this much inactivity (180 days)
# PAIRING_CODE_TTL=10m
# BACKUP_INTERVAL=24h          # 0 disables scheduled backups (only snapshots when data changed)
# BACKUP_RETENTION=14
# MIGRATE_ON_START=true
# MAX_BODY_BYTES=1048576
# MAX_RESTORE_BYTES=33554432
# DB_MAX_OPEN_CONNS=10
